# OpenAI Configuration
# Note: OpenAI API key is now stored securely in Supabase Edge Functions
# Add OPENAI_API_KEY to your Supabase project secrets instead

# Supabase Configuration (if using)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ChatBot Configuration
VITE_CHATBOT_MAX_MESSAGES_PER_SESSION=20
VITE_CHATBOT_MAX_SESSIONS_PER_IP=5
VITE_ENABLE_AI_RESPONSES=true
VITE_ENABLE_ANALYTICS=true

# Analytics. Production is a local dist/ drop, so the committed defaults in
# src/utils/trackers.ts are what ships; these only override them locally.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_META_PIXEL_ID=2060347114601720
VITE_PUBLIC_POSTHOG_KEY=phc_...
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com