# Environment variables for Exotiq.ai

# Analytics
VITE_ENABLE_ANALYTICS=true
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_MIXPANEL_TOKEN=your_mixpanel_token_here

# Apollo Tracking
VITE_ENABLE_APOLLO=true

# OpenAI
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Supabase
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_BLOG_CONTENT_SOURCE=hybrid
VITE_BLOG_BREAK_GLASS=false
VITE_BLOG_BREAK_GLASS_ALLOWLIST=
VITE_BLOG_BREAK_GLASS_TOKEN=
VITE_BLOG_BREAK_GLASS_EXPIRES_AT=

# ElevenLabs
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Other Services
VITE_SENTRY_DSN=your_sentry_dsn_here
VITE_CRISP_WEBSITE_ID=your_crisp_website_id_here 

# --- Marketing & product analytics -------------------------------------------
# Meta (Facebook/Instagram) Pixel. Required for conversion tracking on paid
# Meta campaigns; the pixel only loads after the visitor accepts marketing
# cookies. Find it in Events Manager > Data Sources (a 15-16 digit ID).
VITE_META_PIXEL_ID=

# PostHog. Project API key is public/client-side by design. Loads only after
# the visitor accepts analytics cookies.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
